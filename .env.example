# Modo de autenticación: "auth0", "ldap" (usuario de dominio EGEHID) o "dev" (correo simulado, encabezado X-Dev-User)
VITE_AUTH_MODE=auth0
VITE_API_URL=http://localhost:5080/api
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
VITE_AUTH0_AUDIENCE=https://fiscalizacion.egehid.gob.do/api
