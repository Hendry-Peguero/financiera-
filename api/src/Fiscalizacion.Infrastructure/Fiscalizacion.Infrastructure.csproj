<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fiscalizacion.Application\Fiscalizacion.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <!-- 6.2.4 es la última versión MIT; desde 6.5.0 PDFsharp es AGPL-3.0. No actualizar sin revisar la licencia. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="[6.2.4]" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fuentes del PDF oficial (SIL OFL 1.1): no dependen de las fuentes instaladas en el servidor -->
    <EmbeddedResource Include="Pdf\Fuentes\*.ttf" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
